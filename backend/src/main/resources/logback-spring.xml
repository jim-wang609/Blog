<?xml version="1.0" encoding="UTF-8"?>
<!--
  访客行为日志：VISITOR 这个 logger 的每一行都写进 logs/visitor.log，
  同时也会出现在控制台和 logs/kimon-blog.log（additivity=true）。
  日志目录可用环境变量 LOG_DIR 覆盖；默认在后端工作目录下的 logs/。

  滚动策略：按天 + 按大小。单个日志文件最大 50MB，同一类日志总量上限 2GB。
  （maxFileSize 只有 SizeAndTimeBasedRollingPolicy 支持，普通 TimeBasedRollingPolicy
   不认这个属性，所以这里用 SizeAndTime 策略；文件名里的 %i 是当天分片序号。）
-->
<configuration>
  <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
  <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{18} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/kimon-blog.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/kimon-blog.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="VISITFILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/visitor.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/visitor.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>90</maxHistory>
      <totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <logger name="VISITOR" level="INFO" additivity="true">
    <appender-ref ref="VISITFILE"/>
  </logger>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
