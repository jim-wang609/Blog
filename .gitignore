# ==============================================================================
#  Kimon's Blog —— .gitignore（开源发布版）
#
#  原则：仓库里只保留「代码骨架」，站主的真实数据和上线部署相关的东西都不进版本库。
#
#  两点务必记住：
#    1) 写进 .gitignore 只是让 Git 不再跟踪，不会删除你本地已有的文件；
#    2) 但反过来，git clean -fdx 会把被忽略的文件一起删掉，别在不该跑的地方跑。
#
#  ⚠️ 数据不会丢的前提：下面这些被忽略的数据，GitHub 上不会有任何备份。
#     请单独备份 MySQL + uploads + JWT 密钥，见 README「数据备份与恢复」。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 站点内容种子：真实文章 / 日记 / 留言 / 站点资料
#    首次启动会把 seed.json 导入 MySQL，之后不再读取；文件缺失只会跳过导入。
#    ⚠️ 这里含站主的文章正文、邮箱、所在地等个人信息，绝对不能提交。
#    仓库里只保留结构示例 seed.example.json，见 README「初始化内容」。
# ------------------------------------------------------------------------------
backend/src/main/resources/seed.json

# ------------------------------------------------------------------------------
# 2. 上传文件：真实图片 / 附件（都是用户数据）
#    两个目录本身用 .gitkeep 占位保留，目录里的东西全部忽略。
#    注意顺序：先忽略 uploads 下所有内容，再把两个目录放回来，
#    最后只放回 .gitkeep——被忽略的目录里的文件无法用 ! 规则救回来。
# ------------------------------------------------------------------------------
/uploads/*
!/uploads/images/
!/uploads/files/
/uploads/images/*
!/uploads/images/.gitkeep
/uploads/files/*
!/uploads/files/.gitkeep

# ------------------------------------------------------------------------------
# 3. 运行期状态与密钥
#    backend/storage/secret.key 是 JWT 签名密钥，泄露 = 登录态可被伪造。
#    该目录由程序启动时自动创建，不需要提交。
# ------------------------------------------------------------------------------
backend/storage/
/storage/
*.key
*.p12
*.jks
*.pfx

# ------------------------------------------------------------------------------
# 4. 日志（含访客 IP / UA / 访问记录，属于个人信息）
# ------------------------------------------------------------------------------
logs/
backend/logs/
*.log
*.log.*
hs_err_pid*.log

# ------------------------------------------------------------------------------
# 5. Java / Maven 构建产物（每次都能重新生成）
# ------------------------------------------------------------------------------
backend/target/
target/
*.class
*.jar
*.war
*.hprof

# ------------------------------------------------------------------------------
# 6. 本地临时文件 / 手动备份
# ------------------------------------------------------------------------------
.tmp/
.shots/
.backup/
*.bak
*.bak-*
*.orig
*.rej
*~
*.swp
*.tmp
*.zip
*.tar.gz
*.tgz
*.7z
*.rar

# 数据库导出与备份包（别把 dump 传上去；schema-mysql.sql 在下一条规则里保留）
*.sql.gz
*.sql.dump
/db-*.sql
/*.sql

# ------------------------------------------------------------------------------
# 7. 上线 / 部署相关：GitHub 仓库不需要这些
#    deploy/          服务器地址、Nginx、systemd、一键部署脚本、迁移手册
#    一键更新.bat      它们的 Windows 入口（读 deploy/local.env.bat 里的服务器地址）
#
#    这些文件与「某一台服务器」强绑定，公开仓库里没有意义，而且含真实域名/IP。
#    ⚠️ 忽略 ≠ 删除：文件仍在你本机，双击 一键更新.bat 部署照常可用。
# ------------------------------------------------------------------------------
/deploy/
/一键更新.bat

# ------------------------------------------------------------------------------
# 8. 本地私密配置：密码 / 密钥 / 环境变量
#    生产真正的密码在服务器的 /etc/kimon-blog.env（600，root），不在仓库里。
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
application-local.yml
application-local.properties
*-secret.*

# ------------------------------------------------------------------------------
# 9. 编辑器 / 系统 / AI 工具杂物
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini
.workbuddy/
.claude/
.cursor/

# ------------------------------------------------------------------------------
# 10. 必须提交的东西（列出来是为了防止以后误加规则把它们挡掉）
#    backend/src/main/resources/schema-mysql.sql  建表脚本
#    uploads/*/.gitkeep                          目录占位
# ------------------------------------------------------------------------------
!backend/src/main/resources/schema-mysql.sql
